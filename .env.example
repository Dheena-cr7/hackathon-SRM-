# ==========================================
# CAMPUSOPS — ZERO-COST ENVIRONMENT CONFIG
# ==========================================
# All variables have sensible local defaults.
# No paid API keys or cloud service tokens required.

# Environment Mode
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SECRET_KEY=campusops-insecure-dev-secret-change-in-production-only
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: Local SQLite (aiosqlite) for zero-dependency, zero-cost offline local development.
# Alternative: PostgreSQL (asyncpg) when a PostgreSQL server is running locally or in Docker.
DATABASE_URL=sqlite+aiosqlite:///./data/campusops.db
# DATABASE_URL=postgresql+asyncpg://campusops:campusops@localhost:5432/campusops

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# AI Layer Configurations (Zero-Cost / Offline)
# Layer 1: Deterministic Intelligence (Always Enabled)
AI_LAYER1_ENABLED=True

# Layer 2: Local Sentence Embeddings (Optional, CPU-based)
AI_LAYER2_ENABLED=False
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Layer 3: Optional Local LLM (Off by default, e.g., local Ollama instance)
AI_LAYER3_ENABLED=False
LOCAL_OLLAMA_BASE_URL=http://localhost:11434
LOCAL_OLLAMA_MODEL=llama3.2:1b

# Digital Twin Geometry Settings
CAMPUS_GEOJSON_PATH=./data/campus.geojson
DEFAULT_CAMPUS_NAME="SRM Campus"
